<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\PasswordPolicyBundle\Tests\Integration\Doctrine\XmlHost\XmlHostUser" table="pp_xml_user">
        <id name="id" type="string" length="64"/>
        <field name="password" type="string" length="255"/>
        <field name="passwordChangedAt" column="password_changed_at" type="datetime" nullable="true"/>
        <one-to-many field="passwordHistory" target-entity="Nowo\PasswordPolicyBundle\Tests\Integration\Doctrine\XmlHost\XmlHostPasswordHistory" mapped-by="user" orphan-removal="true">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>
    </entity>
</doctrine-mapping>
