{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN). The light/dark toggle is UiKit's. -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}Password Policy Demo{% endblock %}{% endblock %}

{% block nowo_ui_navigation %}
    {% set _route = app.request.attributes.get('_route') %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('demo_home') }}">PasswordPolicyBundle</a>
        <nav class="nowo-ui-menu" aria-label="PasswordPolicyBundle">
            <a class="nowo-ui-link" href="{{ path('demo_home') }}"{% if _route == 'demo_home' %} aria-current="page"{% endif %}>Home</a>
            <a class="nowo-ui-link" href="{{ path('use_cases_index') }}"{% if _route starts with 'use_case' %} aria-current="page"{% endif %}>Use cases</a>
            <a class="nowo-ui-link" href="{{ path('user_index') }}"{% if _route starts with 'user_' %} aria-current="page"{% endif %}>Users</a>
        </nav>
        <div class="nowo-ui-header__end">
            {% if app.user %}
                <span class="nowo-ui-muted">Logged in as <strong>{{ app.user.email }}</strong></span>
                <a class="nowo-ui-link" href="{{ path('logout') }}">Logout</a>
            {% elseif _route != 'login' %}
                <a class="nowo-ui-link" href="{{ path('login') }}">Login</a>
            {% endif %}
            {{ include('@NowoUiKitBundle/partials/_theme_toggle.html.twig', { compact: true }, false) }}
        </div>
    </header>
{% endblock %}

{#- structured flashes ({title, message}) carry trusted demo markup, so the raw filter stays here -#}
{% block nowo_ui_flashes %}
    {% for type, css in {success: 'success', error: 'error', warning: 'warning', info: 'info'} %}
        {% for message in app.flashes(type) %}
            <div class="nowo-ui-flash nowo-ui-flash--{{ css }}" role="{{ type == 'error' ? 'alert' : 'status' }}">
                {% if message is iterable and message.title is defined %}
                    <p><strong>{{ message.title|raw }}</strong></p>
                    <p>{{ message.message|raw }}</p>
                {% else %}
                    {{ message|raw }}
                {% endif %}
            </div>
        {% endfor %}
    {% endfor %}
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}
