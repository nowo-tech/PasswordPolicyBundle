{% extends 'base.html.twig' %}

{% block title %}Login - Password Policy Demo{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Login'}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Sign in', kind: 'form', form: form, error: error} %}
        {% block section_body %}
            {% if error %}
                <div class="nowo-ui-flash nowo-ui-flash--error" role="alert">
                    <p><strong>Authentication Error</strong></p>
                    <p>{{ error.messageKey|trans(error.messageData, 'security') }}</p>
                </div>
            {% endif %}
            {{ form_start(form, {attr: {id: 'demo-login-form'}}) }}
                {% for child in form %}
                    {% if not child.rendered and child.vars.name != 'submit' %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
                {% do form.submit.setRendered %}
            {{ form_end(form, {render_rest: false}) }}
        {% endblock %}
        {% block section_footer %}
            <button type="submit" form="demo-login-form" class="nowo-ui-btn nowo-ui-btn--primary">{{ form.submit.vars.label }}</button>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Demo credentials for testing', intro: 'After logging in with expired@example.com, navigate to the home page to see the password expiry listener in action.', kind: 'table'} %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead><tr><th scope="col">User</th><th scope="col">Password</th><th scope="col" class="nowo-ui-cell--wrap">State</th></tr></thead>
                <tbody>
                    <tr><th scope="row">expired@example.com</th><td><code class="nowo-ui-code">expired123</code></td><td class="nowo-ui-cell--wrap"><span class="nowo-ui-badge nowo-ui-badge--danger">Password Expired</span> (will trigger the expiry listener)</td></tr>
                    <tr><th scope="row">demo@example.com</th><td><code class="nowo-ui-code">demo123</code></td><td class="nowo-ui-cell--wrap"><span class="nowo-ui-badge nowo-ui-badge--warning">Expiring Soon</span> (expires in 5 days)</td></tr>
                    <tr><th scope="row">admin@example.com</th><td><code class="nowo-ui-code">admin123</code></td><td class="nowo-ui-cell--wrap"><span class="nowo-ui-badge nowo-ui-badge--success">Active</span></td></tr>
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}
{% endblock %}
