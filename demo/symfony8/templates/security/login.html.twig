{% extends 'base.html.twig' %}

{% block title %}Login - Password Policy Demo{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Login'}) }}
{% endblock %}

{% block body %}
    {% if error %}
        <div class="nowo-ui-flash nowo-ui-flash--error" role="alert">
            <p><strong>Authentication Error</strong></p>
            <p>{{ error.messageKey|trans(error.messageData, 'security') }}</p>
        </div>
    {% endif %}

    <section class="nowo-ui-card">
        <div class="nowo-ui-card__body">
            {{ form_start(form) }}
                {% for child in form %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(form) }}
        </div>
    </section>

    <div class="nowo-ui-flash nowo-ui-flash--info" role="note">
        <p><strong>🧪 Demo Credentials for Testing:</strong></p>
        <ul>
            <li><strong>expired@example.com</strong> / <code class="nowo-ui-code">expired123</code> - <span class="nowo-ui-badge nowo-ui-badge--danger">Password Expired</span> (will trigger expiry listener)</li>
            <li><strong>demo@example.com</strong> / <code class="nowo-ui-code">demo123</code> - <span class="nowo-ui-badge nowo-ui-badge--warning">Expiring Soon</span> (expires in 5 days)</li>
            <li><strong>admin@example.com</strong> / <code class="nowo-ui-code">admin123</code> - <span class="nowo-ui-badge nowo-ui-badge--success">Active</span></li>
        </ul>
        <p><strong>💡 Tip:</strong> After logging in with <strong>expired@example.com</strong>, navigate to the home page to see the password expiry listener in action!</p>
    </div>
{% endblock %}
