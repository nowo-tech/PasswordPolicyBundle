{% extends 'base.html.twig' %}

{% block title %}User Details - Password Policy Demo{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'User Details'}) }}
{% endblock %}

{% block body %}
    <a href="{{ path('user_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">← Back to List</a>
    <a href="{{ path('user_edit', {'id': user.id}) }}" class="nowo-ui-btn nowo-ui-btn--outline">Edit</a>
    <a href="{{ path('user_change_password', {'id': user.id}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Change Password</a>

    <div class="nowo-ui-card"><div class="nowo-ui-card__body">
        <h3>User Information</h3>
        <p><strong>ID:</strong> {{ user.id }}</p>
        <p><strong>Email:</strong> {{ user.email }}</p>
        <p><strong>Password Changed At:</strong>
            {% if user.passwordChangedAt %}
                {{ user.passwordChangedAt|date('Y-m-d H:i:s') }}
                <br>
                {% set diff = date('now').timestamp - user.passwordChangedAt.timestamp %}
                {% set days = (diff / 86400)|round %}
                <small>({{ days }} day{{ days != 1 ? 's' : '' }} ago)</small>
            {% else %}
                <em>Never</em>
            {% endif %}
        </p>
        <p><strong>Status:</strong>
            {% if user.passwordChangedAt %}
                {% set daysSince = (date().timestamp - user.passwordChangedAt.timestamp) / 86400 %}
                {% if daysSince >= 90 %}
                    <span class="nowo-ui-badge nowo-ui-badge--danger">Expired ({{ daysSince|round }} days old)</span>
                {% elseif daysSince >= 85 %}
                    <span class="nowo-ui-badge nowo-ui-badge--warning">Expiring Soon ({{ daysSince|round }} days old, {{ (90 - daysSince)|round }} days remaining)</span>
                {% else %}
                    <span class="nowo-ui-badge nowo-ui-badge--success">Active ({{ daysSince|round }} days old, {{ (90 - daysSince)|round }} days remaining)</span>
                {% endif %}
            {% else %}
                <span class="nowo-ui-badge nowo-ui-badge--warning">No Password Set</span>
            {% endif %}
        </p>
    </div></div>

    <div class="nowo-ui-card"><div class="nowo-ui-card__body">
        <h3>Password History ({{ user.passwordHistory|length }} entries)</h3>
        {% if user.passwordHistory|length > 0 %}
            <div class="nowo-ui-table-wrap"><table class="nowo-ui-table nowo-ui-table--striped">
                <thead>
                    <tr>
                        <th>Created At</th>
                        <th>Password Hash</th>
                    </tr>
                </thead>
                <tbody>
                    {% for history in user.passwordHistory %}
                        <tr>
                            <td>{{ history.createdAt|date('Y-m-d H:i:s') }}</td>
                            <td><code class="nowo-ui-code">{{ history.password|slice(0, 20) }}...</code></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table></div>
        {% else %}
            <p><em>No password history available.</em></p>
        {% endif %}
    </div></div>
{% endblock %}
