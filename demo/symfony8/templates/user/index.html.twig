{% extends 'base.html.twig' %}

{% block title %}Users - Password Policy Demo{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}
        <a href="{{ path('demo_home') }}" class="nowo-ui-btn nowo-ui-btn--outline">Back to home</a>
        <a href="{{ path('user_new') }}" class="nowo-ui-btn nowo-ui-btn--primary">New user</a>
    {% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Users Management', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% set expiryDays = 90 %}
    {% set now = date('now') %}
    {% set expiredUsers = [] %}
    {% set expiringSoonUsers = [] %}
    {% for user in users %}
        {% if user.passwordChangedAt %}
            {% set passwordChangedAt = user.passwordChangedAt %}
            {% set expiresAt = passwordChangedAt|date_modify('+' ~ expiryDays ~ ' days') %}
            {% set daysRemaining = ((expiresAt.timestamp - now.timestamp) / 86400)|round %}
            {% if daysRemaining <= 0 %}
                {% set expiredUsers = expiredUsers|merge([user]) %}
            {% elseif daysRemaining <= 5 %}
                {% set expiringSoonUsers = expiringSoonUsers|merge([user]) %}
            {% endif %}
        {% endif %}
    {% endfor %}

    {% set _summary %}Passwords expire after {{ expiryDays }} days from the last change date. "Expired" passwords need to change immediately; "Expiring Soon" ones have less than 5 days remaining.{% if expiredUsers|length > 0 %} {{ expiredUsers|length }} user{{ expiredUsers|length != 1 ? 's have' : ' has' }} expired password{{ expiredUsers|length != 1 ? 's' : '' }}.{% elseif expiringSoonUsers|length > 0 %} {{ expiringSoonUsers|length }} user{{ expiringSoonUsers|length != 1 ? 's have' : ' has' }} password{{ expiringSoonUsers|length != 1 ? 's' : '' }} expiring in 5 days or less.{% endif %}{% endset %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Users', intro: _summary, kind: 'table', empty: users|length == 0, state_message: 'No users found.', users: users, expiryDays: expiryDays, now: now, delete_forms: delete_forms} %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead>
                    <tr>
                        <th scope="col" class="nowo-ui-cell--num">ID</th>
                        <th scope="col">Email</th>
                        <th scope="col" class="nowo-ui-cell--date">Password changed at</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="nowo-ui-cell--num">Password history</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr>
                            <td class="nowo-ui-cell--num">{{ user.id }}</td>
                            <td>{{ user.email }}</td>
                            <td class="nowo-ui-cell--date">
                                {% if user.passwordChangedAt %}
                                    <time datetime="{{ user.passwordChangedAt|date('c') }}">{{ user.passwordChangedAt|date('Y-m-d H:i:s') }}</time>
                                    {% set diff = date('now').timestamp - user.passwordChangedAt.timestamp %}
                                    {% set days = (diff / 86400)|round %}
                                    <span class="nowo-ui-muted">({{ days }} day{{ days != 1 ? 's' : '' }} ago)</span>
                                {% else %}
                                    Never
                                {% endif %}
                            </td>
                            <td>
                                {% include 'user/_password_status.html.twig' with {'user': user} %}
                                {% if user.passwordChangedAt %}
                                    {% set passwordChangedAt = user.passwordChangedAt %}
                                    {% set expiresAt = passwordChangedAt|date_modify('+' ~ expiryDays ~ ' days') %}
                                    {% set daysRemaining = ((expiresAt.timestamp - now.timestamp) / 86400)|round %}
                                    {% if daysRemaining <= 0 %}
                                        <span class="nowo-ui-muted">Expired {{ (daysRemaining * -1) }} day{{ (daysRemaining * -1) != 1 ? 's' : '' }} ago</span>
                                    {% elseif daysRemaining <= 5 %}
                                        <span class="nowo-ui-muted">Expires in {{ daysRemaining }} day{{ daysRemaining != 1 ? 's' : '' }}</span>
                                    {% elseif daysRemaining <= 15 %}
                                        <span class="nowo-ui-muted">Expires in {{ daysRemaining }} days</span>
                                    {% else %}
                                        <span class="nowo-ui-muted">{{ daysRemaining }} days remaining</span>
                                    {% endif %}
                                {% endif %}
                            </td>
                            <td class="nowo-ui-cell--num">{{ user.passwordHistory|length }} entries</td>
                            <td>
                                {% include 'user/_user_actions.html.twig' with {'user': user} %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
        {% block section_empty_action %}<a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('user_new') }}">Create the first user</a>{% endblock %}
    {% endembed %}
{% endblock %}
