{% extends 'base.html.twig' %}

{% block title %}Edit User - Password Policy Demo{% endblock %}

{% block styles %}
    {{ parent() }}
    <style>
        h1 {
            display: block;
        }
    </style>
{% endblock %}

{% block body %}
    <h1>Edit User #{{ user.id }}</h1>

    <a href="{{ path('user_index') }}" class="btn btn-secondary">← Back to List</a>
    <a href="{{ path('user_show', {'id': user.id}) }}" class="btn btn-secondary">View</a>

    {{ form_start(form) }}
        {# REQ-TWIG-003: child loop (the .form-group wrapper and the help text come from the FormType row_attr / help options) #}
        {% for child in form %}
            {% if not child.rendered %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}

        <button type="submit" class="btn">Update User</button>
    {{ form_end(form) }}
{% endblock %}
