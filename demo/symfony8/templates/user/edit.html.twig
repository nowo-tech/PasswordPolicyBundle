{% extends 'base.html.twig' %}

{% block title %}Edit User - Password Policy Demo{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}
        <a href="{{ path('user_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">Back to list</a>
        <a href="{{ path('user_show', {'id': user.id}) }}" class="nowo-ui-btn nowo-ui-btn--outline">View</a>
    {% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Edit User #' ~ user.id, toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Edit user', kind: 'form', form: form} %}
        {% block section_body %}
            {{ form_start(form, {attr: {id: 'demo-user-form'}}) }}
                {% for child in form %}
                    {% if not child.rendered and child.vars.name != 'submit' %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
                {% do form.submit.setRendered %}
            {{ form_end(form, {render_rest: false}) }}
        {% endblock %}
        {% block section_footer %}
            <button type="submit" form="demo-user-form" class="nowo-ui-btn nowo-ui-btn--primary">{{ form.submit.vars.label }}</button>
        {% endblock %}
    {% endembed %}
{% endblock %}
