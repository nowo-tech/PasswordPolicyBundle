<a href="{{ path('user_show', {'id': user.id}) }}" class="btn">View</a>
<a href="{{ path('user_edit', {'id': user.id}) }}" class="btn btn-warning">Edit</a>
<a href="{{ path('user_change_password', {'id': user.id}) }}" class="btn btn-success">Change Password</a>
{% set delete_form = delete_forms[user.id] %}
{{ form_start(delete_form) }}
    {% for child in delete_form %}{% if not child.rendered %}{{ form_row(child) }}{% endif %}{% endfor %}
    <button type="submit" class="btn btn-danger">Delete</button>
{{ form_end(delete_form) }}
