{% extends 'base.html.twig' %}

{% block title %}New User - Password Policy Demo{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Create New User'}) }}
{% endblock %}

{% block body %}
    <a href="{{ path('user_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">← Back to List</a>

    <section class="nowo-ui-card">
        <div class="nowo-ui-card__body">
            {{ form_start(form) }}
            {% for child in form %}
                {% if not child.rendered %}
                    {{ form_row(child) }}
                {% endif %}
            {% endfor %}
        {{ form_end(form) }}
        </div>
    </section>
{% endblock %}
