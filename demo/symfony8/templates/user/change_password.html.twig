{% extends 'base.html.twig' %}

{% block title %}Change Password - Password Policy Demo{% endblock %}

{% block styles %}
    {{ parent() }}
    <style>
        h1 {
            display: block;
        }
        .info-box {
            background: #e7f3ff;
        }
    </style>
{% endblock %}

{% block body %}
    <h1>Change Password for {{ user.email }}</h1>

    <a href="{{ path('user_show', {'id': user.id}) }}" class="btn btn-secondary">← Back to User</a>

    <div class="info-box">
        <strong>Note:</strong> Changing the password will update the password history and reset the password expiry date.
    </div>

    {{ form_start(form) }}
        {# REQ-TWIG-003: child loop (the .form-group wrapper and the help text come from the FormType row_attr / help options) #}
        {% for child in form %}
            {% if not child.rendered %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}

        {# The repeated field's own error ("must match") is not part of its first/second rows #}
        {{ form_errors(form.plainPassword) }}

        <button type="submit" class="btn">Change Password</button>
    {{ form_end(form) }}
{% endblock %}
