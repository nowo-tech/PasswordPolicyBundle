{% extends 'base.html.twig' %}

{% block title %}Change Password - Password Policy Demo{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Change Password for ' ~ user.email}) }}
{% endblock %}

{% block body %}
    <a href="{{ path('user_show', {'id': user.id}) }}" class="nowo-ui-btn nowo-ui-btn--outline">← Back to User</a>

    <div class="nowo-ui-flash nowo-ui-flash--info" role="note">
        <strong>Note:</strong> Changing the password will update the password history and reset the password expiry date.
    </div>

    <section class="nowo-ui-card">
        <div class="nowo-ui-card__body">
            {{ form_start(form) }}
            {% for child in form %}
                {% if not child.rendered %}
                    {{ form_row(child) }}
                {% endif %}
            {% endfor %}

            {# The repeated field's own error ("must match") is not part of its first/second rows #}
            {{ form_errors(form.plainPassword) }}
        {{ form_end(form) }}
        </div>
    </section>
{% endblock %}
