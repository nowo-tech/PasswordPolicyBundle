{% extends 'base.html.twig' %}

{% block title %}Change Password - Password Policy Demo{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}
        <a href="{{ path('user_show', {'id': user.id}) }}" class="nowo-ui-btn nowo-ui-btn--outline">Back to user</a>
    {% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Change Password for ' ~ user.email, toolbar: _toolbar, intro: 'Changing the password will update the password history and reset the password expiry date.'}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Change password', kind: 'form', form: form, user: user} %}
        {% block section_body %}
            {{ form_start(form, {attr: {id: 'demo-user-form'}}) }}
                {% for child in form %}
                    {% if not child.rendered and child.vars.name != 'submit' %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
                {# The repeated field's own error ("must match") is not part of its first/second rows #}
                {{ form_errors(form.plainPassword) }}
                {% do form.submit.setRendered %}
            {{ form_end(form, {render_rest: false}) }}
        {% endblock %}
        {% block section_footer %}
            <button type="submit" form="demo-user-form" class="nowo-ui-btn nowo-ui-btn--primary">{{ form.submit.vars.label }}</button>
        {% endblock %}
    {% endembed %}
{% endblock %}
