{% extends 'use_cases/base.html.twig' %}

{% block title %}Password Expiry - Use Cases{% endblock %}

{% block use_case_title %}Password Expiry Detection{% endblock %}

{% block use_case_content %}
    {% if user %}
        {% include 'use_cases/_user_status.html.twig' with {'user': user, 'isExpired': isExpired, 'daysRemaining': daysRemaining, 'daysSinceExpiry': daysSinceExpiry} %}
        
        <h2>Configuration</h2>
        <div class="nowo-ui-card"><div class="nowo-ui-card__body">
            <h3>Locked Routes (notified_routes)</h3>
            <p>These routes trigger password expiry checks:</p>
            <ul>
                {% for route in lockedRoutes %}
                    <li><code class="nowo-ui-code">{{ route }}</code></li>
                {% else %}
                    <li><em>No locked routes configured</em></li>
                {% endfor %}
            </ul>
            
            <h3>Excluded Routes (excluded_notified_routes)</h3>
            <p>These routes are excluded from expiry checks:</p>
            <ul>
                {% for route in excludedRoutes %}
                    <li><code class="nowo-ui-code">{{ route }}</code></li>
                {% else %}
                    <li><em>No excluded routes configured</em></li>
                {% endfor %}
            </ul>
            
            <h3>Reset Password Route</h3>
            <p><code class="nowo-ui-code">{{ resetPasswordRoute ?: 'Not configured' }}</code></p>
        </div></div>
        
        <h2>How It Works</h2>
        <ol>
            <li>The <code class="nowo-ui-code">PasswordExpiryListener</code> listens to kernel request events</li>
            <li>When accessing routes in <code class="nowo-ui-code">notified_routes</code>, it checks if the password is expired</li>
            <li>If expired, it shows a flash message (and optionally redirects if <code class="nowo-ui-code">redirect_on_expiry</code> is enabled)</li>
            <li>Routes in <code class="nowo-ui-code">excluded_notified_routes</code> are never checked, preventing redirect loops</li>
        </ol>
    {% else %}
        {% include 'use_cases/_not_authenticated.html.twig' %}
    {% endif %}
{% endblock %}

