{% extends 'use_cases/base.html.twig' %}

{% block title %}Password Reuse Prevention - Use Cases{% endblock %}

{% block use_case_title %}Password Reuse Prevention{% endblock %}

{% block use_case_content %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'How password reuse prevention works', intro: 'The bundle prevents users from reusing passwords that are in their password history. This is enforced by the @PasswordPolicy validator constraint.', kind: 'content'} %}{% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Test cases', intro: 'The following users have password history that can be used to test reuse prevention.', kind: 'table', empty: testCases|length == 0, state_message: 'No users with password history found.'} %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead>
                    <tr>
                        <th scope="col">User</th>
                        <th scope="col" class="nowo-ui-cell--num">History count</th>
                        <th scope="col" class="nowo-ui-cell--date">Oldest password date</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for testCase in testCases %}
                        <tr>
                            <td>{{ testCase.user.email }}</td>
                            <td class="nowo-ui-cell--num">{{ testCase.historyCount }}</td>
                            <td class="nowo-ui-cell--date">
                                {% if testCase.oldestPassword %}
                                    <time datetime="{{ testCase.oldestPassword.createdAt|date('c') }}">{{ testCase.oldestPassword.createdAt|date('Y-m-d H:i:s') }}</time>
                                {% else %}
                                    N/A
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('user_change_password', {'id': testCase.user.id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Change password</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'How to test', kind: 'content'} %}
        {% block section_body %}
            <ol>
                <li>Go to a user's "Change Password" page</li>
                <li>Try to set a password that matches one in the user's history</li>
                <li>The <code class="nowo-ui-code">@PasswordPolicy</code> validator will reject it with an error</li>
                <li>You must use a password that is not in the history</li>
            </ol>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Validation flow', kind: 'content'} %}
        {% block section_body %}
            <ol>
                <li>User submits new password via form</li>
                <li>Symfony Validator processes the <code class="nowo-ui-code">@PasswordPolicy</code> constraint</li>
                <li><code class="nowo-ui-code">PasswordPolicyValidator</code> checks password against history</li>
                <li>If password matches history, validation fails</li>
                <li>Form shows validation error to user</li>
            </ol>
        {% endblock %}
    {% endembed %}
{% endblock %}
