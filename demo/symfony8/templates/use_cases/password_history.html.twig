{% extends 'use_cases/base.html.twig' %}

{% block title %}Password History - Use Cases{% endblock %}

{% block use_case_title %}Password History Tracking{% endblock %}

{% block use_case_content %}
    {% if user %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Current user: ' ~ user.email, kind: 'detail'} %}
            {% block section_body %}
                <p><strong>Passwords to remember:</strong> {{ passwordsToRemember }}</p>
                <p><strong>Current history count:</strong> {{ historyCount }}</p>
            {% endblock %}
        {% endembed %}

        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Password history', kind: 'table', empty: history|length == 0, state_message: 'No password history yet. History is created automatically when you change your password.'} %}
            {% block section_body %}
                <table class="nowo-ui-data-table">
                    <thead>
                        <tr>
                            <th scope="col" class="nowo-ui-cell--num">#</th>
                            <th scope="col" class="nowo-ui-cell--date">Created at</th>
                            <th scope="col">Password hash (first 20 chars)</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for entry in history %}
                            <tr>
                                <td class="nowo-ui-cell--num">{{ loop.index }}</td>
                                <td class="nowo-ui-cell--date"><time datetime="{{ entry.createdAt|date('c') }}">{{ entry.createdAt|date('Y-m-d H:i:s') }}</time></td>
                                <td><code class="nowo-ui-code">{{ entry.password|slice(0, 20) }}...</code></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endblock %}
        {% endembed %}

        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'How it works', kind: 'content', user: user} %}
            {% block section_body %}
                <ol>
                    <li>When a password is changed, the old password is stored in the password history</li>
                    <li>The <code class="nowo-ui-code">PasswordEntityListener</code> listens to Doctrine <code class="nowo-ui-code">onFlush</code> events</li>
                    <li>It automatically creates a new password history entry</li>
                    <li>If the history exceeds <code class="nowo-ui-code">passwords_to_remember</code>, the oldest entries are removed</li>
                    <li>The <code class="nowo-ui-code">@PasswordPolicy</code> validator checks against this history to prevent reuse</li>
                </ol>
            {% endblock %}
            {% block section_footer %}
                <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('user_change_password', {'id': user.id}) }}">Change your password</a>
            {% endblock %}
        {% endembed %}
    {% else %}
        {% include 'use_cases/_not_authenticated.html.twig' %}
    {% endif %}
{% endblock %}
