{% if user %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Current user: ' ~ user.email, kind: 'detail'} %}
        {% block section_actions %}
            {% if isExpired %}<span class="nowo-ui-badge nowo-ui-badge--danger">EXPIRED</span>{% else %}<span class="nowo-ui-badge nowo-ui-badge--success">ACTIVE</span>{% endif %}
        {% endblock %}
        {% block section_body %}
            <p><strong>Password status:</strong>
                {% if isExpired %}
                    {% if daysSinceExpiry is defined and daysSinceExpiry %}Expired {{ daysSinceExpiry }} day(s) ago{% else %}Expired{% endif %}
                {% else %}
                    {% if daysRemaining is defined and daysRemaining %}Expires in {{ daysRemaining }} day(s){% else %}Active{% endif %}
                {% endif %}
            </p>
            {% if user.passwordChangedAt %}
                <p><strong>Password changed:</strong> <time datetime="{{ user.passwordChangedAt|date('c') }}">{{ user.passwordChangedAt|date('Y-m-d H:i:s') }}</time></p>
            {% endif %}
        {% endblock %}
    {% endembed %}
{% endif %}
