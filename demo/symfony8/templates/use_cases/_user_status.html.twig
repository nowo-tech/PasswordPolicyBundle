{% if user %}
    <div class="nowo-ui-flash nowo-ui-flash--{% if isExpired %}error{% else %}success{% endif %}" role="note">
        <h3>Current User: {{ user.email }}</h3>
        <p><strong>Password Status:</strong> 
            {% if isExpired %}
                <span class="nowo-ui-badge nowo-ui-badge--danger">EXPIRED</span>
                {% if daysSinceExpiry is defined and daysSinceExpiry %}
                    <span>Expired {{ daysSinceExpiry }} day(s) ago</span>
                {% endif %}
            {% else %}
                <span class="nowo-ui-badge nowo-ui-badge--success">ACTIVE</span>
                {% if daysRemaining is defined and daysRemaining %}
                    <span>Expires in {{ daysRemaining }} day(s)</span>
                {% endif %}
            {% endif %}
        </p>
        {% if user.passwordChangedAt %}
            <p><strong>Password Changed:</strong> {{ user.passwordChangedAt|date('Y-m-d H:i:s') }}</p>
        {% endif %}
    </div>
{% endif %}

