{% extends 'base.html.twig' %}

{% block title %}Use Cases - Password Policy Bundle Demo{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}
        <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('user_index') }}">Users management</a>
        <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('demo_home') }}">Back to home</a>
    {% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Password Policy Bundle - Use Cases', intro: "This page demonstrates all the features and use cases of the Password Policy Bundle. Each use case shows a different aspect of the bundle's functionality.", toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Before you start', intro: 'To fully test these use cases, you should be authenticated: use one of the demo users (expired@example.com / expired123, demo@example.com / demo123, admin@example.com / admin123).', kind: 'content'} %}
        {% block section_footer %}<a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('login') }}">Login / logout</a>{% endblock %}
    {% endembed %}

    <div class="nowo-ui-cards">
        {% for useCase in use_cases %}
            {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: useCase.name, intro: useCase.description, kind: 'list', useCase: useCase} %}
                {% block section_body %}
                    <p><strong>Features demonstrated:</strong></p>
                    <ul>
                        {% for feature in useCase.features %}
                            <li>{{ feature }}</li>
                        {% endfor %}
                    </ul>
                {% endblock %}
                {% block section_footer %}<a href="{{ path(useCase.route) }}" class="nowo-ui-btn nowo-ui-btn--outline">View use case</a>{% endblock %}
            {% endembed %}
        {% endfor %}
    </div>
{% endblock %}
