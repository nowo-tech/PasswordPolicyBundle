{% extends 'use_cases/base.html.twig' %}

{% block title %}Redirect on Expiry - Use Cases{% endblock %}

{% block use_case_title %}Redirect on Password Expiry{% endblock %}

{% block use_case_content %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Current status', kind: 'detail'} %}
        {% block section_actions %}
            {% if redirectEnabled %}<span class="nowo-ui-badge nowo-ui-badge--success">ENABLED</span>{% else %}<span class="nowo-ui-badge nowo-ui-badge--warning">DISABLED</span>{% endif %}
        {% endblock %}
        {% block section_body %}
            <p><strong>Redirect on expiry:</strong> {{ redirectEnabled ? 'enabled' : 'disabled (default behavior)' }}</p>
            <p><strong>Reset password route:</strong> <code class="nowo-ui-code">{{ resetPasswordRoute ?: 'Not configured' }}</code></p>
        {% endblock %}
    {% endembed %}

    {% if user %}
        {% include 'use_cases/_user_status.html.twig' with {
            'user': user,
            'isExpired': isExpired,
            'daysRemaining': null,
            'daysSinceExpiry': null
        } %}
        {% if isExpired %}
            {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Effect for this user', kind: 'content'} %}
                {% block section_body %}
                    <p><strong>{{ redirectEnabled ? '(Would be redirected to reset password route)' : '(Only flash message shown - no redirect)' }}</strong></p>
                {% endblock %}
            {% endembed %}
        {% endif %}
    {% endif %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'How it works', intro: 'When redirect_on_expiry: true is enabled in configuration:', kind: 'content'} %}
        {% block section_body %}
            <ol>
                <li>User with expired password accesses a route in <code class="nowo-ui-code">notified_routes</code></li>
                <li><code class="nowo-ui-code">PasswordExpiryListener</code> detects the expired password</li>
                <li>Instead of just showing a flash message, it automatically redirects to <code class="nowo-ui-code">reset_password_route_name</code></li>
                <li>Flash message is still shown before redirect</li>
                <li>If the reset password route doesn't exist, it gracefully falls back to just showing the flash message</li>
            </ol>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Configuration', kind: 'content'} %}
        {% block section_body %}
            <pre class="nowo-ui-code-block" tabindex="0" role="region" aria-label="Code example"><code>nowo_password_policy:
    entities:
        App\Entity\User:
            reset_password_route_name: user_reset_password
    expiry_listener:
        redirect_on_expiry: true  # Enable automatic redirection</code></pre>
        {% endblock %}
        {% block section_footer %}
            <p class="nowo-ui-muted">In this demo, redirect is disabled to allow you to explore all features. Enable it in <code class="nowo-ui-code">config/packages/nowo_password_policy.yaml</code> to test automatic redirection.</p>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Default behavior (redirect_on_expiry: false)', intro: 'By default, the bundle only shows a flash message when password expires. This is less intrusive and allows users to:', kind: 'content'} %}
        {% block section_body %}
            <ul>
                <li>See the warning message</li>
                <li>Continue using the application (with warnings)</li>
                <li>Change password when convenient</li>
            </ul>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'When to enable redirect', intro: 'Enable redirect_on_expiry: true when:', kind: 'content'} %}
        {% block section_body %}
            <ul>
                <li>Security policy requires immediate password change</li>
                <li>Users should be forced to change password before continuing</li>
                <li>You want a more strict enforcement of password expiry</li>
            </ul>
        {% endblock %}
    {% endembed %}
{% endblock %}
