{% extends 'use_cases/base.html.twig' %}

{% block title %}Password Validation - Use Cases{% endblock %}

{% block use_case_title %}Password Validation{% endblock %}

{% block use_case_content %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: '@PasswordPolicy validator constraint', intro: 'The bundle provides a Symfony validator constraint that automatically checks passwords against the password history.', kind: 'content'} %}{% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Validation rules', kind: 'list'} %}
        {% block section_body %}
            <ul>
                {% for rule in validationRules %}
                    <li>{{ rule }}</li>
                {% endfor %}
            </ul>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Usage in entity', kind: 'content'} %}
        {% block section_body %}
            <pre class="nowo-ui-code-block" tabindex="0" role="region" aria-label="Code example"><code>use Nowo\PasswordPolicyBundle\Validator\PasswordPolicy;

class User implements HasPasswordPolicyInterface
{
    #[PasswordPolicy]
    private ?string $plainPassword = null;

    // ... rest of entity
}</code></pre>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'How it works', kind: 'content'} %}
        {% block section_body %}
            <ol>
                <li>The <code class="nowo-ui-code">@PasswordPolicy</code> constraint is applied to the <code class="nowo-ui-code">$plainPassword</code> field</li>
                <li>When the form is validated, Symfony calls <code class="nowo-ui-code">PasswordPolicyValidator</code></li>
                <li>The validator retrieves the entity from the validation context</li>
                <li>It calls <code class="nowo-ui-code">PasswordPolicyService::getHistoryByPassword()</code> to check if the password exists in history</li>
                <li>If found, validation fails with an appropriate error message</li>
                <li>The error is displayed in the form</li>
            </ol>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Integration with forms', intro: 'The validator works seamlessly with Symfony Forms:', kind: 'content'} %}
        {% block section_body %}
            <pre class="nowo-ui-code-block" tabindex="0" role="region" aria-label="Code example"><code>$form = $this->createForm(ChangePasswordType::class);

if ($form->isSubmitted() && $form->isValid()) {
    // Password passed validation - not in history
    // Proceed with password change
} else {
    // Validation errors are automatically displayed
    // User must choose a different password
}</code></pre>
        {% endblock %}
        {% block section_footer %}
            <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('user_index') }}">Users management</a>
        {% endblock %}
    {% endembed %}
{% endblock %}
