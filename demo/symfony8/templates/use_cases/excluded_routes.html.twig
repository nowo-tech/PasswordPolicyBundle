{% extends 'use_cases/base.html.twig' %}

{% block title %}Excluded Routes - Use Cases{% endblock %}

{% block use_case_title %}Excluded Routes{% endblock %}

{% block use_case_content %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Understanding excluded routes', intro: note, kind: 'content'} %}{% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Locked routes (notified_routes)', intro: 'These routes trigger password expiry checks.', kind: 'list'} %}
        {% block section_body %}
            <ul>
                {% for route in lockedRoutes %}
                    <li><code class="nowo-ui-code">{{ route }}</code></li>
                {% else %}
                    <li>No locked routes configured</li>
                {% endfor %}
            </ul>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Excluded routes (excluded_notified_routes)', intro: "These routes are excluded from expiry checks, even if they're in notified_routes.", kind: 'list'} %}
        {% block section_body %}
            <ul>
                {% for route in excludedRoutes %}
                    <li><code class="nowo-ui-code">{{ route }}</code> <span class="nowo-ui-badge nowo-ui-badge--warning">Excluded</span></li>
                {% else %}
                    <li>No excluded routes configured</li>
                {% endfor %}
            </ul>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Why exclude routes?', intro: 'Excluded routes are essential to prevent redirect loops and allow users to:', kind: 'content'} %}
        {% block section_body %}
            <ul>
                <li><strong>Logout</strong> - Users should be able to logout even with expired passwords</li>
                <li><strong>Reset Password</strong> - Users need to access the password reset page</li>
                <li><strong>Login</strong> - New login attempts should not be blocked</li>
            </ul>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Configuration example', intro: 'Best practice: always exclude login, logout and password reset routes to prevent redirect loops.', kind: 'content'} %}
        {% block section_body %}
            <pre class="nowo-ui-code-block" tabindex="0" role="region" aria-label="Code example"><code>nowo_password_policy:
    entities:
        App\Entity\User:
            notified_routes:
                - demo_home
                - user_index
            excluded_notified_routes:
                - login
                - logout
                - user_change_password</code></pre>
        {% endblock %}
    {% endembed %}
{% endblock %}
